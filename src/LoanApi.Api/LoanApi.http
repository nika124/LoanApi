@LoanApi_HostAddress = http://localhost:5102
@AccessToken = paste-token-here

POST {{LoanApi_HostAddress}}/api/auth/users/register
Content-Type: application/json

{
  "firstName": "Demo",
  "lastName": "User",
  "username": "demo.user",
  "email": "demo.user@example.com",
  "age": 28,
  "monthlyIncome": 4000,
  "password": "StrongPassword123"
}

###

POST {{LoanApi_HostAddress}}/api/auth/users/login
Content-Type: application/json

{
  "usernameOrEmail": "demo.user",
  "password": "StrongPassword123"
}

###

POST {{LoanApi_HostAddress}}/api/loans
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "loanType": "FastLoan",
  "amount": 1500,
  "currency": "GEL",
  "periodMonths": 12
}

###

GET {{LoanApi_HostAddress}}/api/loans
Authorization: Bearer {{AccessToken}}
Accept: application/json
